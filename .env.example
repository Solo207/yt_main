# Port the service listens on (EasyPanel maps this automatically)
PORT=3000

# Required. n8n must send this as the "x-api-key" header on every request.
# Generate a long random value, e.g.: openssl rand -hex 32
API_KEY=

# Proxy passed to yt-dlp's --proxy flag, e.g. http://user:pass@host:port
# Leave blank to skip using a proxy.
YTDLP_PROXY=

# Path to a cookies.txt file for yt-dlp's --cookies flag.
# Leave blank to skip using cookies.
# If set, mount a persistent volume containing this file (see README).
COOKIES_PATH=/app/data/cookies.txt

# Max number of yt-dlp/ffmpeg processes allowed to run at the same time.
# Tune this based on your VPS's CPU core count.
CONCURRENCY=3

# Timeouts in milliseconds, per operation
DOWNLOAD_TIMEOUT_MS=300000
CONVERT_TIMEOUT_MS=120000

# Max upload size for /convert-ogg, in bytes (default 50MB)
MAX_UPLOAD_BYTES=52428800
